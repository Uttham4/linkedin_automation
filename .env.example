# NVIDIA API Configuration
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY
NVIDIA_MODEL=moonshotai/kimi-k3

# Unsplash API Configuration
UNSPLASH_ACCESS_KEY=YOUR_UNSPLASH_ACCESS_KEY

# LinkedIn API Configuration
LINKEDIN_ACCESS_TOKEN=YOUR_LINKEDIN_ACCESS_TOKEN
AUTHOR_URN=urn:li:person:YOUR_MEMBER_ID

# GitHub Integration Configuration
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=optional_github_personal_access_token

# SMTP Email Configuration (Gmail App Password recommended)
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
RECIPIENT_EMAIL=your_email@gmail.com

# Server & Remote Security Configuration
SERVER_BASE_URL=https://your-app-name.onrender.com
API_SECRET=your_custom_secret_key_for_remote_triggers
PORT=5000
